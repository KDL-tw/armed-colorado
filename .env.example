# Supabase (Special projects TSOR — Free tier)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Umbrella Civic (Billwatch) — leave empty for stub mode
UMBRELLA_API_URL=
UMBRELLA_API_KEY=

# Optional email confirmations for /alerts
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@example.com

# Admin gate (password-protected /admin) — generate: openssl rand -base64 18
# Set the SAME value in .env.local and in Vercel env (or /admin fails closed with 503 there).
ADMIN_PASSWORD=
# Set to 1 when the site is served over HTTPS (e.g. Vercel) so the session
# cookie is only sent over secure connections. Leave empty on plain-HTTP LAN.
ADMIN_SECURE_COOKIE=
